# Copy to .env and fill in. Never commit the real .env file.

# MongoDB connection string, e.g. a local server or a MongoDB Atlas cluster
MONGO_URI=mongodb://127.0.0.1:27017/finance-tracker

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Login and register requests allowed per IP per 15 minutes
AUTH_RATE_LIMIT=30
